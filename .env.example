# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=
# Identifiant de l'audience Resend : liste d'attente et nouveaux comptes (resend.com > Audiences)
RESEND_AUDIENCE_ID=
# Supabase (Project Settings > API Keys) : l'adresse du projet et la clé publique, lisibles par le navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase : la clé secrète, serveur seulement (relevés Instagram, vérification des comptes)
SUPABASE_SECRET_KEY=
# Instagram (Meta for Developers) : jeton utilisateur longue durée de Gael, collé une fois.
# Semper en tire seul l'identifiant Instagram et un jeton de page permanent (table meta_link).
META_ACCESS_TOKEN=
# Mot de passe du relevé quotidien (Vercel l'envoie au cron)
CRON_SECRET=

# Ouverture des inscriptions à l'outil : 1 = ouvert. Absent = fermé (seuls les comptes existants se connectent).
SEMPER_OPEN=
